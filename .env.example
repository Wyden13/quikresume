# NextAuth (Auth.js v5)
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_TRUST_HOST=true

# Firebase Admin SDK service account (Firestore database id "quikresume")
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the private key with literal \n sequences on one line
FIREBASE_PRIVATE_KEY=

# Optional: raises the GitHub API limit for profile link checks (60/h per server IP without it)
GITHUB_TOKEN=

# Z.ai GLM (resume import, tags, Job Match, coach review, About you)
GLM_API_KEY=
# Optional reasoning effort overrides (low | high | max; glm-5.3 has no "medium").
# Defaults: reconcile max (background), review high (background), tailor high. See src/lib/glm/effort.ts.
# GLM_EFFORT_RECONCILE=max
# GLM_EFFORT_REVIEW=high
# GLM_EFFORT_TAILOR=high
