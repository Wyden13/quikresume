# Public origin, no trailing slash. Used for canonical URLs, robots.txt and sitemap.xml.
# Defaults to https://quikresume.vercel.app when unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# NextAuth (Auth.js v5)
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_TRUST_HOST=true

# Firebase Admin SDK service account (Firestore database id "quikresume")
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the private key with literal \n sequences on one line
FIREBASE_PRIVATE_KEY=

# Optional: raises the GitHub API limit for profile link checks (60/h per server IP without it)
GITHUB_TOKEN=

# Z.ai GLM (resume import, tags, Job Match, coach review, About you)
GLM_API_KEY=
# Optional reasoning effort overrides (low | high | max; glm-5.3 has no "medium").
# Defaults: reconcile max (background), review high (background), tailor high. See src/lib/glm/effort.ts.
# GLM_EFFORT_RECONCILE=max
# GLM_EFFORT_REVIEW=high
# GLM_EFFORT_TAILOR=high

# Optional: per-user daily AI budget (src/lib/security/ai-budget.ts). Counted per UTC day in the
# top-level `ai_usage` collection; a user over either number gets a 429 from every AI route.
# AI_DAILY_TOKEN_BUDGET=2000000
# AI_DAILY_CALL_BUDGET=400
